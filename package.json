{
  "name": "domecs-workspace",
  "private": true,
  "version": "2026.6.8",
  "description": "DOMECS — deterministic ECS runtime for DOM-heavy operable simulations. Workspace root.",
  "packageManager": "pnpm@10.30.2",
  "type": "module",
  "scripts": {
    "test": "pnpm -r --parallel test",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --parallel typecheck",
    "test:release": "node --test test/release-validation.test.mjs",
    "release:validate": "node scripts/validate-release.mjs",
    "api:surface": "node scripts/api-surface.mjs",
    "api:check": "node --test test/api-surface.test.mjs",
    "doctest": "node scripts/doctest.mjs",
    "doctest:check": "node --test test/doctest.test.mjs",
    "publish:npm": "pnpm -r --filter \"@domecs/*\" build && pnpm -r --filter \"@domecs/*\" publish --access public",
    "bench": "node bench/run.mjs",
    "codemod": "jscodeshift --parser=tsx -t tools/codemod/domecs-v1.cjs"
  },
  "devDependencies": {
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^22.10.1",
    "jscodeshift": "^17.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
